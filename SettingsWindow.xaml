<Window x:Class="HonnyakuKun.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻訳設定"
        AutomationProperties.AutomationId="SettingsWindow"
        Width="640"
        Height="680"
        MinWidth="520"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#E2E8F0">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="OpenAI APIキー" Margin="0,0,0,5" />
            <PasswordBox x:Name="ApiKeyBox" AutomationProperties.AutomationId="ApiKeyBox" Padding="8" Background="#1E293B" Foreground="White" BorderBrush="#475569" />
            <TextBlock Margin="0,5,0,0" Foreground="#94A3B8" FontSize="11"
                       Text="未入力なら OPENAI_API_KEY 環境変数を使用します。設定JSONには保存しません。" />
            <CheckBox x:Name="RememberApiKeyBox" AutomationProperties.AutomationId="RememberApiKeyBox" Margin="0,9,0,0" Foreground="#E2E8F0"
                      Content="このWindowsユーザーの資格情報マネージャーに保存する" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="モデル" Margin="0,0,0,5" />
                <ComboBox x:Name="ModelBox" AutomationProperties.AutomationId="ModelBox" IsEditable="True" Padding="7" Background="#F8FAFC" Foreground="#0F172A">
                    <ComboBoxItem Content="gpt-5.6-luna" />
                    <ComboBoxItem Content="gpt-5.6-terra" />
                    <ComboBoxItem Content="gpt-4o-mini" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="翻訳先" Margin="0,0,0,5" />
                <TextBox x:Name="TargetLanguageBox" AutomationProperties.AutomationId="TargetLanguageBox" Padding="8" Background="#1E293B" Foreground="White" BorderBrush="#475569" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="保持する履歴数" Margin="0,0,0,5" />
            <TextBox x:Name="HistoryLimitBox" AutomationProperties.AutomationId="HistoryLimitBox" Width="100" HorizontalAlignment="Left" Padding="8"
                     Background="#1E293B" Foreground="White" BorderBrush="#475569" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="基本プロンプト" Margin="0,0,0,5" />
            <TextBox x:Name="BasePromptBox" AutomationProperties.AutomationId="BasePromptBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Padding="9" Background="#1E293B" Foreground="White" BorderBrush="#475569" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,14">
            <TextBlock Text="ゲーム・人物・用語などのコンテキスト" Margin="0,0,0,5" />
            <TextBox x:Name="GameContextBox" AutomationProperties.AutomationId="GameContextBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Padding="9" Background="#1E293B" Foreground="White" BorderBrush="#475569" />
        </StackPanel>

        <TextBlock Grid.Row="5" x:Name="ValidationText" AutomationProperties.AutomationId="ValidationText" Foreground="#FCA5A5" Margin="0,0,0,8" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button AutomationProperties.AutomationId="CancelButton" Content="キャンセル" Click="CancelButton_Click" />
            <Button AutomationProperties.AutomationId="SaveButton" Content="保存" Background="#0F766E" BorderBrush="#14B8A6" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
