<Window x:Class="Madoyaku.LayoutNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置を保存"
        AutomationProperties.AutomationId="LayoutNameWindow"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#E2E8F0">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="配置名" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBox x:Name="NameBox" Grid.Row="1" AutomationProperties.AutomationId="LayoutNameBox"
                 MinWidth="360" Padding="8" Background="#1E293B" Foreground="White" BorderBrush="#475569"
                 KeyDown="NameBox_KeyDown" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button AutomationProperties.AutomationId="CancelLayoutButton" Content="キャンセル" Click="CancelButton_Click" />
            <Button AutomationProperties.AutomationId="SaveLayoutButton" Content="保存" Background="#0F766E" BorderBrush="#14B8A6" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
