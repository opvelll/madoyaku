<Window x:Class="HonnyakuKun.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻訳くん"
        Width="820"
        Height="520"
        MinWidth="460"
        MinHeight="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowActivated="False">
    <Border BorderBrush="#22D3EE" BorderThickness="2" CornerRadius="8" Background="#01000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="CaptureRow" Height="*" />
                <RowDefinition x:Name="SplitterRow" Height="8" />
                <RowDefinition x:Name="ResultRow" Height="220" />
                <RowDefinition x:Name="ControlRow" Height="38" />
            </Grid.RowDefinitions>

            <Grid x:Name="CaptureSurface" Grid.Row="0" Background="#01000000"
                  PreviewMouseLeftButtonDown="CaptureSurface_PreviewMouseLeftButtonDown">
                <Border BorderBrush="#8022D3EE" BorderThickness="1" Margin="6" CornerRadius="4" />
                <StackPanel x:Name="CaptureHintPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock x:Name="CaptureHintText" Text="この透明領域を翻訳したい画面に重ねます"
                               Foreground="#A7CBD5E1" FontSize="14" HorizontalAlignment="Center" />
                    <TextBlock Text="透明領域で移動・枠の端や角でサイズ変更"
                               Foreground="#7F94A3B8" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>

            <GridSplitter x:Name="ResultSplitter"
                          Grid.Row="1"
                          Height="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#CC334155"
                          Cursor="SizeNS"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          ToolTip="ドラッグして翻訳領域の高さを変更" />

            <Border x:Name="ResultPanel" Grid.Row="2" MinHeight="150" Background="#EB020617">
                <Grid Margin="14,10,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="SourcePanel"
                            MaxHeight="52"
                            Margin="0,0,0,6"
                            Padding="8,4"
                            Background="#991E293B"
                            BorderBrush="#475569"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="Collapsed">
                        <TextBox x:Name="SourceText"
                                 AutomationProperties.Name="原文"
                                 MinHeight="18"
                                 MaxHeight="40"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 Foreground="#E2E8F0"
                                 FontSize="14" />
                    </Border>

                    <TextBox x:Name="TranslationText"
                             Grid.Row="1"
                             Text="翻訳結果がここに表示されます。"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="False"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Foreground="White"
                             FontSize="20" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="#E610172A" CornerRadius="0,0,6,6" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center" Margin="10,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" Fill="#22D3EE" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="翻訳くん" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Grid.Column="2" Text="準備完了" Foreground="#67E8F9" FontSize="11"
                                   Margin="12,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2,4,2">
                        <Button x:Name="TranslateButton" Content="翻訳" Background="#0F766E" BorderBrush="#14B8A6"
                                ToolTip="翻訳 (Ctrl+Shift+T)" Click="TranslateButton_Click" />
                        <Button Content="履歴消去" Click="ClearHistoryButton_Click" />
                        <Button Content="設定" Click="SettingsButton_Click" />
                        <Button x:Name="CollapseButton" Content="⌄" Width="30" Padding="0" FontSize="18"
                                AutomationProperties.Name="たたむ"
                                ToolTip="上側の翻訳領域をたたむ"
                                Click="CollapseButton_Click" />
                        <Button Content="×" Width="34" Padding="0" Background="#7F1D1D" BorderBrush="#B91C1C" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
